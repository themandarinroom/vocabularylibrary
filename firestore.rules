rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validYearLevel(yearLevelId) { return yearLevelId in ['prep', 'year-1', 'year-2', 'year-3', 'year-4', 'year-5', 'year-6']; }
    function isAuthorisedTeacher() { return request.auth != null && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)) && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.active == true; }
    function validTeacherAudio(audio, expectedPath) { return audio is map && audio.keys().hasOnly(['path', 'downloadURL', 'contentType', 'revision']) && audio.path == expectedPath && audio.downloadURL is string && audio.contentType is string && audio.contentType.matches('audio/.*') && audio.revision is int; }
    function validPractice(practice, yearLevelId, practiceId) { return practice is map && practice.keys().hasOnly(['label', 'words', 'teacherAudio', 'substitution']) && practice.label is string && practice.label.size() <= 60 && practice.words is list && practice.words.size() > 0 && practice.words.size() <= 50 && (!practice.keys().hasAny(['substitution']) || (practice.substitution is map && practice.substitution.keys().hasOnly(['enabled', 'targetWordId', 'vocabulary', 'keyVocabSource', 'vocabularySetId']) && practice.substitution.enabled == true && practice.substitution.targetWordId is string && practice.substitution.targetWordId.size() > 0 && (((!practice.substitution.keys().hasAny(['keyVocabSource']) || practice.substitution.keyVocabSource == 'manual') && practice.substitution.vocabulary is list && practice.substitution.vocabulary.size() > 0 && practice.substitution.vocabulary.size() <= 20) || (practice.substitution.keyVocabSource == 'vocabulary-library' && practice.substitution.vocabularySetId is string && practice.substitution.vocabularySetId.matches('[a-z0-9]+(-[a-z0-9]+)*'))))) && (!practice.keys().hasAny(['teacherAudio']) || validTeacherAudio(practice.teacherAudio, 'teacher-recordings/' + yearLevelId + '/' + practiceId + '/latest')); }
    function validYearLevelDocument(yearLevelId) { return request.resource.data.keys().hasOnly(['yearLevelId', 'yearLevelLabel', 'lessonTitle', 'practices', 'displaySettings', 'audioSettings', 'published', 'updatedAt']) && request.resource.data.yearLevelId == yearLevelId && request.resource.data.yearLevelLabel is string && request.resource.data.lessonTitle is string && request.resource.data.lessonTitle.size() <= 80 && request.resource.data.practices is map && request.resource.data.practices.keys().hasOnly(['core', 'challenge']) && request.resource.data.practices.keys().hasAll(['core', 'challenge']) && validPractice(request.resource.data.practices.core, yearLevelId, 'core') && validPractice(request.resource.data.practices.challenge, yearLevelId, 'challenge') && request.resource.data.displaySettings is map && request.resource.data.audioSettings is map && request.resource.data.published == true && request.resource.data.updatedAt == request.time; }
    function validVocabularyVoice(data, setId, itemId) { return data.keys().hasOnly(['setId', 'itemId', 'teacherAudioUrl', 'storagePath', 'contentType', 'revision', 'updatedAt']) && data.setId == setId && data.itemId == itemId && data.teacherAudioUrl is string && data.storagePath.matches('vocabulary/' + setId + '/' + itemId + '/teacher-voice-[0-9]+') && data.contentType is string && data.contentType.matches('audio/.*') && data.revision is int && data.updatedAt == request.time; }
    function validVocabularySet(data, setId) { return data.keys().hasOnly(['id', 'yearLevel', 'title', 'chineseTitle', 'description', 'items', 'published', 'updatedAt', 'updatedBy']) && data.id == setId && setId.matches('[a-z0-9]+(-[a-z0-9]+)*') && data.yearLevel is int && data.yearLevel >= 0 && data.yearLevel <= 6 && data.title is string && data.title.size() > 0 && data.title.size() <= 100 && data.chineseTitle is string && data.chineseTitle.size() <= 100 && data.description is string && data.description.size() <= 500 && data.items is list && data.items.size() <= 100 && data.published == true && data.updatedAt == request.time && data.updatedBy == request.auth.uid; }
    function validDeletedVocabularySet(data, setId) { return data.keys().hasOnly(['id', 'deleted', 'published', 'updatedAt', 'updatedBy']) && data.id == setId && setId.matches('[a-z0-9]+(-[a-z0-9]+)*') && data.deleted == true && data.published == true && data.updatedAt == request.time && data.updatedBy == request.auth.uid; }
    function validLesson(lesson) { return lesson is map && lesson.keys().hasOnly(['id', 'title', 'learningIntention', 'notes', 'vocabularySetId', 'speakingActivityId', 'resources']) && lesson.id is string && lesson.id.size() > 0 && lesson.id.size() <= 100 && lesson.title is string && lesson.title.size() <= 120 && lesson.learningIntention is string && lesson.learningIntention.size() <= 1000 && lesson.notes is string && lesson.notes.size() <= 5000 && lesson.vocabularySetId is string && (lesson.vocabularySetId == '' || lesson.vocabularySetId.matches('[a-z0-9]+(-[a-z0-9]+)*')) && lesson.speakingActivityId is string && (lesson.speakingActivityId == '' || lesson.speakingActivityId.matches('(prep|year-[1-6]):(core|challenge)')) && lesson.resources is string && lesson.resources.size() <= 5000; }
    function validUnit(data, unitId) { return data.keys().hasOnly(['id', 'yearLevel', 'englishTitle', 'chineseTitle', 'lessons', 'updatedAt', 'updatedBy']) && data.id == unitId && unitId.matches('[a-z0-9]+(-[a-z0-9]+)*') && data.yearLevel is int && data.yearLevel >= 0 && data.yearLevel <= 6 && data.englishTitle is string && data.englishTitle.size() > 0 && data.englishTitle.size() <= 100 && data.chineseTitle is string && data.chineseTitle.size() <= 100 && data.lessons is list && data.lessons.size() > 0 && data.lessons.size() <= 30 && validLesson(data.lessons[0]) && data.updatedAt == request.time && data.updatedBy == request.auth.uid; }

    match /yearLevels/{yearLevelId} { allow get: if isAuthorisedTeacher() || (validYearLevel(yearLevelId) && resource.data.published == true); allow list: if false; allow create, update: if validYearLevel(yearLevelId) && isAuthorisedTeacher() && validYearLevelDocument(yearLevelId); allow delete: if false; }
    match /authorizedTeachers/{teacherId} { allow get: if request.auth != null && request.auth.uid == teacherId; allow list, create, update, delete: if false; }
    match /vocabularySets/{setId} {
      allow get: if true;
      allow list: if resource.data.published == true || isAuthorisedTeacher();
      allow create, update: if isAuthorisedTeacher() && (validVocabularySet(request.resource.data, setId) || validDeletedVocabularySet(request.resource.data, setId));
      allow delete: if isAuthorisedTeacher();
    }
    match /vocabularyTeacherVoices/{voiceId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAuthorisedTeacher() && validVocabularyVoice(request.resource.data, request.resource.data.setId, request.resource.data.itemId) && voiceId == request.resource.data.setId + '--' + request.resource.data.itemId;
      allow delete: if isAuthorisedTeacher();
    }
    match /units/{unitId} { allow read: if isAuthorisedTeacher(); allow create, update: if isAuthorisedTeacher() && validUnit(request.resource.data, unitId); allow delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
