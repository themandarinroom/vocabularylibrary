rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validYearLevel(yearLevelId) { return yearLevelId in ['prep', 'year-1', 'year-2', 'year-3', 'year-4', 'year-5', 'year-6']; }
    function isAuthorisedTeacher() { return request.auth != null && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)) && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.active == true; }
    function validStableId(value) { return value is string && value.matches('[a-z0-9]+(-[a-z0-9]+)*'); }
    function validTeacherAudio(audio, expectedPath, practiceId) { return audio is map && audio.keys().hasOnly(['path', 'downloadURL', 'contentType', 'revision']) && (audio.path == expectedPath || audio.path.matches('teacher-recordings/practices/[a-z0-9]+(-[a-z0-9]+)*/' + practiceId + '/latest')) && audio.downloadURL is string && audio.contentType is string && audio.contentType.matches('audio/.*') && audio.revision is int; }
    function validPractice(practice, yearLevelId, practiceId) { return practice is map && practice.keys().hasOnly(['label', 'words', 'teacherAudio', 'substitution']) && practice.label is string && practice.label.size() <= 60 && practice.words is list && practice.words.size() > 0 && practice.words.size() <= 50 && (!practice.keys().hasAny(['substitution']) || (practice.substitution is map && practice.substitution.keys().hasOnly(['enabled', 'targetWordId', 'vocabulary', 'keyVocabSource', 'vocabularySetId']) && practice.substitution.enabled == true && practice.substitution.targetWordId is string && practice.substitution.targetWordId.size() > 0 && (((!practice.substitution.keys().hasAny(['keyVocabSource']) || practice.substitution.keyVocabSource == 'manual') && practice.substitution.vocabulary is list && practice.substitution.vocabulary.size() > 0 && practice.substitution.vocabulary.size() <= 20) || (practice.substitution.keyVocabSource == 'vocabulary-library' && practice.substitution.vocabularySetId is string && practice.substitution.vocabularySetId.matches('[a-z0-9]+(-[a-z0-9]+)*'))))) && (!practice.keys().hasAny(['teacherAudio']) || validTeacherAudio(practice.teacherAudio, 'teacher-recordings/' + yearLevelId + '/' + practiceId + '/latest', practiceId)); }
    function validYearLevelDocument(yearLevelId) { return request.resource.data.keys().hasOnly(['yearLevelId', 'yearLevelLabel', 'lessonTitle', 'practices', 'displaySettings', 'audioSettings', 'published', 'updatedAt']) && request.resource.data.yearLevelId == yearLevelId && request.resource.data.yearLevelLabel is string && request.resource.data.lessonTitle is string && request.resource.data.lessonTitle.size() <= 80 && request.resource.data.practices is map && request.resource.data.practices.keys().hasOnly(['core', 'challenge']) && request.resource.data.practices.keys().hasAll(['core', 'challenge']) && validPractice(request.resource.data.practices.core, yearLevelId, 'core') && validPractice(request.resource.data.practices.challenge, yearLevelId, 'challenge') && request.resource.data.displaySettings is map && request.resource.data.audioSettings is map && request.resource.data.published == true && request.resource.data.updatedAt == request.time; }
    function validVocabularyVoice(data, setId, itemId) { return data.keys().hasOnly(['setId', 'itemId', 'teacherAudioUrl', 'storagePath', 'contentType', 'revision', 'updatedAt']) && data.setId == setId && data.itemId == itemId && data.teacherAudioUrl is string && data.storagePath.matches('vocabulary/' + setId + '/' + itemId + '/teacher-voice-[0-9]+') && data.contentType is string && data.contentType.matches('audio/.*') && data.revision is int && data.updatedAt == request.time; }
    function validVocabularySet(data, setId) { return data.keys().hasOnly(['id', 'yearLevel', 'title', 'chineseTitle', 'description', 'coverImage', 'coverImageStoragePath', 'coverImageGenerated', 'items', 'published', 'updatedAt', 'updatedBy']) && data.id == setId && setId.matches('[a-z0-9]+(-[a-z0-9]+)*') && data.yearLevel is int && data.yearLevel >= 0 && data.yearLevel <= 6 && data.title is string && data.title.size() > 0 && data.title.size() <= 100 && data.chineseTitle is string && data.chineseTitle.size() <= 100 && data.description is string && data.description.size() <= 500 && data.coverImageGenerated is bool && (data.coverImage == null || (data.coverImage is string && data.coverImage.size() <= 2000)) && (data.coverImageStoragePath == null || (data.coverImageStoragePath is string && data.coverImageStoragePath.matches('vocabulary/' + setId + '/cover/image-[0-9]+\\.webp'))) && (!data.coverImageGenerated || (data.coverImage is string && data.coverImageStoragePath is string)) && data.items is list && data.items.size() <= 100 && data.published == true && data.updatedAt == request.time && data.updatedBy == request.auth.uid; }
    function validDeletedVocabularySet(data, setId) { return data.keys().hasOnly(['id', 'deleted', 'published', 'updatedAt', 'updatedBy']) && data.id == setId && setId.matches('[a-z0-9]+(-[a-z0-9]+)*') && data.deleted == true && data.published == true && data.updatedAt == request.time && data.updatedBy == request.auth.uid; }
    function validSavedPractice(practiceId) { return request.resource.data.keys().hasOnly(['id', 'schemaVersion', 'yearLevelId', 'yearLevelLabel', 'title', 'practices', 'displaySettings', 'audioSettings', 'deleted', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'migration']) && request.resource.data.id == practiceId && validStableId(practiceId) && request.resource.data.schemaVersion == 1 && validYearLevel(request.resource.data.yearLevelId) && request.resource.data.yearLevelLabel is string && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80 && request.resource.data.practices is map && request.resource.data.practices.keys().hasOnly(['core', 'challenge']) && request.resource.data.practices.keys().hasAll(['core', 'challenge']) && validPractice(request.resource.data.practices.core, request.resource.data.yearLevelId, 'core') && validPractice(request.resource.data.practices.challenge, request.resource.data.yearLevelId, 'challenge') && request.resource.data.displaySettings is map && request.resource.data.audioSettings is map && request.resource.data.deleted is bool && request.resource.data.createdAt is timestamp && request.resource.data.createdBy is string && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid; }
    function validLesson(lesson) { return lesson is map && lesson.keys().hasOnly(['id', 'title', 'learningIntention', 'notes', 'vocabularySetId', 'speakingActivityId', 'speakingPracticeId', 'resources']) && lesson.id is string && lesson.id.size() > 0 && lesson.id.size() <= 100 && lesson.title is string && lesson.title.size() <= 120 && lesson.learningIntention is string && lesson.learningIntention.size() <= 1000 && lesson.notes is string && lesson.notes.size() <= 5000 && lesson.vocabularySetId is string && (lesson.vocabularySetId == '' || lesson.vocabularySetId.matches('[a-z0-9]+(-[a-z0-9]+)*')) && (!lesson.keys().hasAny(['speakingActivityId']) || (lesson.speakingActivityId is string && (lesson.speakingActivityId == '' || lesson.speakingActivityId.matches('(prep|year-[1-6]):(core|challenge)')))) && (!lesson.keys().hasAny(['speakingPracticeId']) || (lesson.speakingPracticeId is string && (lesson.speakingPracticeId == '' || validStableId(lesson.speakingPracticeId)))) && lesson.resources is string && lesson.resources.size() <= 5000; }
    function validUnit(data, unitId) { return data.keys().hasOnly(['id', 'yearLevel', 'englishTitle', 'chineseTitle', 'lessons', 'updatedAt', 'updatedBy']) && data.id == unitId && unitId.matches('[a-z0-9]+(-[a-z0-9]+)*') && data.yearLevel is int && data.yearLevel >= 0 && data.yearLevel <= 6 && data.englishTitle is string && data.englishTitle.size() > 0 && data.englishTitle.size() <= 100 && data.chineseTitle is string && data.chineseTitle.size() <= 100 && data.lessons is list && data.lessons.size() > 0 && data.lessons.size() <= 30 && validLesson(data.lessons[0]) && data.updatedAt == request.time && data.updatedBy == request.auth.uid; }

    match /yearLevels/{yearLevelId} { allow get: if isAuthorisedTeacher() || (validYearLevel(yearLevelId) && resource.data.published == true); allow list: if false; allow create, update: if validYearLevel(yearLevelId) && isAuthorisedTeacher() && validYearLevelDocument(yearLevelId); allow delete: if false; }
    match /speakingPractices/{practiceId} {
      allow get: if isAuthorisedTeacher() || resource.data.deleted == false;
      allow list: if isAuthorisedTeacher();
      allow create: if isAuthorisedTeacher() && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid && validSavedPractice(practiceId);
      allow update: if isAuthorisedTeacher() && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.yearLevelId == resource.data.yearLevelId && validSavedPractice(practiceId);
      allow delete: if false;
    }
    match /speakingState/{yearLevelId} {
      allow get: if validYearLevel(yearLevelId);
      allow list: if false;
      allow create, update: if isAuthorisedTeacher() && validYearLevel(yearLevelId) && request.resource.data.keys().hasOnly(['yearLevelId', 'currentPracticeId', 'publishedAt', 'publishedBy']) && request.resource.data.yearLevelId == yearLevelId && validStableId(request.resource.data.currentPracticeId) && request.resource.data.publishedAt == request.time && request.resource.data.publishedBy == request.auth.uid && getAfter(/databases/$(database)/documents/speakingPractices/$(request.resource.data.currentPracticeId)).data.yearLevelId == yearLevelId && getAfter(/databases/$(database)/documents/speakingPractices/$(request.resource.data.currentPracticeId)).data.deleted == false;
      allow delete: if false;
    }
    match /authorizedTeachers/{teacherId} { allow get: if request.auth != null && request.auth.uid == teacherId; allow list, create, update, delete: if false; }
    match /vocabularySets/{setId} {
      allow get: if true;
      allow list: if resource.data.published == true || isAuthorisedTeacher();
      allow create, update: if isAuthorisedTeacher() && (validVocabularySet(request.resource.data, setId) || validDeletedVocabularySet(request.resource.data, setId));
      allow delete: if isAuthorisedTeacher();
    }
    match /vocabularyTeacherVoices/{voiceId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAuthorisedTeacher() && validVocabularyVoice(request.resource.data, request.resource.data.setId, request.resource.data.itemId) && voiceId == request.resource.data.setId + '--' + request.resource.data.itemId;
      allow delete: if isAuthorisedTeacher();
    }
    match /units/{unitId} { allow read: if isAuthorisedTeacher(); allow create, update: if isAuthorisedTeacher() && validUnit(request.resource.data, unitId); allow delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
